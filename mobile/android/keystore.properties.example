# Release-signing configuration for the Android app, following Android's
# standard `keystore.properties` convention (the same pattern Android
# Studio's "Generate Signed Bundle / APK" wizard writes).
#
# Copy this file to `keystore.properties` in this directory (mobile/android/)
# and fill in real values. `keystore.properties` itself is gitignored — never
# commit it, and never commit the `.jks`/`.keystore` file it points to.
# Without this file present, `app/build.gradle` falls back to debug signing
# so local builds and CI keep working; a release build intended for a store
# upload needs the real file to exist locally, created by whoever holds the
# release keystore.
#
# Generate a release keystore once (keep it and these passwords in a
# password manager or secrets vault — losing it means you can never again
# publish an update to an app already on the Play Store under this key).
# Run this from mobile/android/ so the keystore lands next to this file:
#
#   keytool -genkey -v -keystore staff-scheduler-release.keystore \
#     -alias staff-scheduler -keyalg RSA -keysize 2048 -validity 10000

storeFile=staff-scheduler-release.keystore
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=staff-scheduler
keyPassword=REPLACE_WITH_KEY_PASSWORD
