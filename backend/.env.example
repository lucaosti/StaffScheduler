# Server Configuration
PORT=3001
NODE_ENV=development
# Number of reverse-proxy hops in front of this process to trust for
# X-Forwarded-For/-Proto. Leave at 0 (or unset) for a directly-exposed
# instance (dev, or a single-instance deployment with no load balancer) —
# trusting a hop that isn't a real proxy lets a client spoof its own IP and
# bypass rate limiting. Set to 1 only when running behind the nginx load
# balancer from the docker-compose.scale.yml overlay.
TRUST_PROXY_HOPS=0

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=staff_scheduler
DB_USER=scheduler_user
DB_PASSWORD=scheduler_password

# Optional MySQL read replica (#323) for analytical SELECTs (reports,
# calendar feed generation, audit log listing/export). Leave DB_REPLICA_HOST
# unset for a single-instance deployment — those reads then keep going to the
# primary above, unchanged. Any DB_REPLICA_* variable left unset falls back
# to its DB_* counterpart (a replica is normally the same schema/user under a
# different host).
# DB_REPLICA_HOST=replica.internal
# DB_REPLICA_PORT=3306
# DB_REPLICA_NAME=staff_scheduler
# DB_REPLICA_USER=scheduler_user
# DB_REPLICA_PASSWORD=scheduler_password
# DB_REPLICA_POOL_LIMIT=30

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
# Refresh-token lifetime (the session length). Rotated on every use.
JWT_REFRESH_EXPIRES_IN=30d

# Redis Configuration
# On by default: the shared caches (token-revocation blacklist, auth-context,
# module state) use Redis whenever it is reachable, so multiple backend
# instances stay consistent and token revocation survives a restart. If no
# Redis is running the caches fall back to in-process state automatically.
# Point REDIS_URL at your instance (include the password: redis://:pass@host:6379);
# set REDIS_ENABLED=false to disable Redis entirely for a single-instance deployment.
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=Staff Scheduler
EMAIL_FROM_ADDRESS=noreply@staffscheduler.com

# Gusto payroll export (optional — unset means the "gusto" provider refuses
# to run rather than sending anywhere; no default account ships with this repo)
# GUSTO_API_KEY=
# GUSTO_COMPANY_ID=
# GUSTO_API_BASE_URL=https://api.gusto.com

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# Report Configuration
REPORT_STORAGE_PATH=./reports
REPORT_CLEANUP_DAYS=30

# Optimization engine. 'or-tools' (default) = optimal Python CP-SAT solver, with
# a signalled greedy fallback if Python is unavailable. 'greedy' (or legacy
# 'javascript') = fast best-effort draft engine, chosen on purpose.
OPTIMIZATION_ENGINE=or-tools
OPTIMIZATION_TIMEOUT=300000
OPTIMIZATION_MAX_ITERATIONS=10000
OPTIMIZATION_POPULATION_SIZE=100
OPTIMIZATION_MUTATION_RATE=0.1
OPTIMIZATION_CROSSOVER_RATE=0.8

# Observability. Bearer token protecting GET /metrics (Prometheus scrape).
# Leave empty for local dev; set it in any networked deployment so metrics are
# not exposed unauthenticated.
METRICS_TOKEN=

# OpenTelemetry tracing. Off unless OTEL_ENABLED=true OR an OTLP endpoint is set.
# When on, HTTP/Express/mysql2 are auto-instrumented and spans carry request.id
# (matching the X-Request-Id header/logs).
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=staff-scheduler-backend

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Security Configuration
BCRYPT_ROUNDS=12
# The request budget. Counters live in the shared cache store (Redis when
# configured), so the numbers below are the limit for the DEPLOYMENT, not for
# each replica — which is what they used to mean, silently.
RATE_LIMIT_WINDOW_MS=900000
# Per caller: an individual user, or an IP for unauthenticated traffic.
RATE_LIMIT_MAX_REQUESTS=100
# Per organization, once the caller's tenant is known. Larger because this
# bucket aggregates every employee behind it; charging a whole tenant the
# per-caller figure would throttle a large one at the size of a small one.
RATE_LIMIT_ORG_MAX_REQUESTS=2000

# Auth-context cache TTL in milliseconds. 0 (default) = disabled: permissions
# are re-resolved from the database on every request so grants/revocations
# apply immediately. A small TTL (e.g. 5000) cuts the ~6 auth queries per
# request at the cost of revocations taking up to TTL to propagate.
AUTH_PERMISSION_CACHE_TTL_MS=0

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Notifications Configuration
NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true
IN_APP_NOTIFICATIONS_ENABLED=true
